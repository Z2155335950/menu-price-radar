# 默认 mock：使用本地确定性解析，不调用外部模型，不需要 AI Key。
AI_MODE=mock
# 真实文本模型可以改为 openai-compatible，并填写下面的配置。
# AI_MODE=openai-compatible

# SQLite 数据库文件，默认是 data/app.db。
# DATABASE_PATH=data/app.db

# 接入真实模型时再填写，不要把真实 Key 提交到 Git。
# 文本提取使用 AI_MODEL；图片识别使用 AI_VISION_MODEL（缺失时回退到 AI_MODEL）。
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=
# AI_MODEL=
# AI_VISION_MODEL=
